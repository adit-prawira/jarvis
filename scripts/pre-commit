#!/bin/bash
# Pre-commit hook: run ruff on Python files changed in this branch vs main.

set -euo pipefail

BASE_BRANCH="main"

if ! git rev-parse --verify "${BASE_BRANCH}" >/dev/null 2>&1; then
    echo "pre-commit: skip — no '${BASE_BRANCH}' branch to diff against."
    exit 0
fi

MERGE_BASE=$(git merge-base "${BASE_BRANCH}" HEAD 2>/dev/null) || true
if [ -z "${MERGE_BASE}" ]; then
    echo "pre-commit: skip — no common ancestor with '${BASE_BRANCH}'."
    exit 0
fi

CHANGED=$(git diff --name-only --diff-filter=ACMR "${MERGE_BASE}"..HEAD | grep '\.py$' || true)

if [ -z "${CHANGED}" ]; then
    exit 0
fi

echo "pre-commit: ruff check for branch-diff files..."
# Shellcheck disable=SC2086 — intentional word-splitting for file list
uv run ruff check ${CHANGED}
